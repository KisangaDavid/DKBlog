---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "David's Blog";
const description = 'A collection of random puzzles and thoughts';

let allPosts = await getCollection('posts')
allPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
---

<BaseLayout title={title} description={description} current="">
  <div id="all-posts-container" class="container all-blogs-container">
    <header class="all-posts-header">
      <h1>All Posts</h1>
      <hr />
    </header>
    {allPosts.map((post, index) => {
      const href = `/${post.data.slug}`;
      return (
        <div>
          { index !== 0 && <hr /> }
          <a href={href}>
            <div class="post-item">
              <div class="post-item-thumbnail-slot">
                <Image class="post-item-thumbnail" src={post.data.thumbnailUrl} alt="" loading="lazy" />
              </div>
              <div class="post-item-content">
                <h3>
                {post.data.title}
                </h3>
                <div class="post-item-date">
                  {post.data.publishDate}
                </div>
                <p>{post.data.description}</p>
                <div class="post-item-footer">
                  <span class="post-item-date">Read More →</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      )
    })}
  </div>
</BaseLayout>

<style>
  #all-posts-container {
    max-width: 60em;
  }

  .all-posts-header {
    width: 100%;
    text-align: center;
    margin-bottom: 1rem;
  }

  .all-posts-header h1 {
    width: 100%;
    padding: 0;
    margin-bottom: 0;
    font-size: 2.4em;
    text-align: center;
  }

  .all-posts-header hr {
    margin: 1rem auto;
    max-width: 95%;
    width: 45rem;
  }

  .post-item-footer {
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .post-item-date {
    color: var(--text-secondary);
    text-align: left;
    font-size: 0.9em;  
    margin-right: 1rem;
  }

  .container > div > hr {
    margin: 0.3125rem auto;
  }

  .post-item {
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border-radius: 0.625rem;
    padding: 3.75rem 0;
  }

  .post-item-thumbnail {
    position: absolute;
    top: 50%;
    left: 50%;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.3125rem;
    transform: translate(-50%, -50%);
  }

  .post-item-thumbnail-slot {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
  }

  .post-item-content {
    min-width: 0;
    margin-left: calc(40% + 2.5rem);
    padding: 0 0.9375rem 0 0;
  }

  .post-item-content h3,
  .post-item-content p {
    margin-top: 0;
  }

  a {
    text-decoration: none;
  }

  .post-item p {
    font-size: 1em;
    line-height: 1.7em;
  }
  @media (hover: hover) {
    .post-item:hover {
      cursor: pointer;
      transform: scale(1.04);
      z-index: 1;
  }
}

  @media (max-width: 37.5rem) {
    .post-item {
      padding: 2.875rem 0;
    }

    .post-item-thumbnail-slot {
      width: 35%;
    }

    .post-item-content {
      margin-left: calc(35% + 0.75rem);
      padding: 0 0.5rem 0 0;
    }

    .post-item-content p {
      line-height: 1.5em;
    }
  }

</style>
